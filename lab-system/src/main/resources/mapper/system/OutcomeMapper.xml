<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.hengyu.lab.system.outcome.infrastructure.mapper.OutcomeMapper">
  <resultMap id="BaseResultMap" type="com.hengyu.lab.system.outcome.domain.Outcome">
    <id property="id" column="id"/>
    <result property="title" column="title"/>
    <result property="status" column="status"/>

    <result property="type"
      column="outcome_type"
      javaType="com.hengyu.lab.system.outcome.domain.constant.OutcomeType"
      typeHandler="com.baomidou.mybatisplus.core.handlers.MybatisEnumTypeHandler"/>

    <collection property="authors" column="id" select="com.hengyu.lab.system.outcome.infrastructure.mapper.AuthorMapper.selectByOutcomeId">
    </collection>

    <discriminator javaType="String" column="outcome_type">
      <case value="PAPER" resultMap="PaperResultMap"></case>
    </discriminator>
  </resultMap>

  <resultMap id="PaperResultMap" type="com.hengyu.lab.system.outcome.domain.PaperOutcome" extends="BaseResultMap">
    <result property="journalName" column="journal_name"/>
    <result property="issn" column="issn"/>
    <result property="publishTime" column="publish_time"/>
  </resultMap>

  <select id="findById" resultMap="BaseResultMap">
    SELECT
      t1.id, t1.title, t1.status, t1.type AS outcome_type,
      t2.journal_name, t2.issn, t2.publish_time
    FROM sys_outcome as t1
    LEFT JOIN sys_outcome_paper as t2 ON t1.id = t2.outcome_id
    where t1.id = #{id} AND t1.deleted = 0
  </select>


  <select id="selectPageDomain" resultMap="BaseResultMap">
    SELECT o.id,
    o.title,
    o.status,
    o.type AS outcome_type,
    p.issn,
    p.journal_name,
    p.publish_time
    FROM sys_outcome as o
    LEFT JOIN sys_outcome_paper as p ON o.id = p.outcome_id
    <where>
      o.deleted = 0
      <if test="ew != null and ew.sqlSegment != null and ew.sqlSegment != ''">
        AND ${ew.sqlSegment}
      </if>
    </where>
  </select>


</mapper>