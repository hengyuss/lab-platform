<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.hengyu.lab.system.outcome.infrastructure.mapper.PaperOutcomeQryMapper">
  <resultMap id="BaseResultMap" type="com.hengyu.lab.system.outcome.application.dto.BaseOutcomeDTO">
    <id property="id" column="id"/>
    <result property="title" column="title"/>
    <result property="status" column="status"/>

    <result property="type"
      column="outcome_type"
      javaType="com.hengyu.lab.system.outcome.domain.constant.OutcomeType"
      typeHandler="com.baomidou.mybatisplus.core.handlers.MybatisEnumTypeHandler"/>
  </resultMap>

  <resultMap id="PaperResultMap" type="com.hengyu.lab.system.outcome.application.dto.PaperOutcomeDTO" extends="BaseResultMap">
    <result property="journalName" column="journal_name"/>
    <result property="issn" column="issn"/>
    <result property="publishTime" column="publish_time"/>
    <result property="publishYear" column="publish_year"/>
    <result column="fund" property="fund"
      typeHandler="com.baomidou.mybatisplus.extension.handlers.JacksonTypeHandler"/>
  </resultMap>


  <select id="selectOutcomePage" resultMap="PaperResultMap">
    SELECT o.id,
    o.title,
    o.oss_path,
    o.status,
    o.type AS outcome_type,
    p.issn,
    p.journal_name,
    p.publish_time,
    p.publish_year,
    p.dblp_key,
    p.paper_type,
    p.fund,
    p.journal_partition,
    p.factor,
    p.ee
    FROM sys_outcome as o
    LEFT JOIN sys_outcome_paper as p ON o.id = p.outcome_id
    <where>
      o.deleted = 0
      <if test="ew != null and ew.sqlSegment != null and ew.sqlSegment != ''">
        AND ${ew.sqlSegment}
      </if>
    </where>
  </select>

</mapper>
